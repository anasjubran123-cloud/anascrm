{
  "name": "convergent-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convergent Technology Company corporate website (mother-company site, bilingual AR/EN, static Astro).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .astro,.ts,.tsx,.js,.mjs,.cjs --max-warnings=0",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,cjs,md,mdx,json,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,cjs,md,mdx,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
