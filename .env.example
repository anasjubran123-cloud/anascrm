# Convergent Technology — environment variables
#
# Copy this file to .env at the repo root and fill in real values for local
# dev. The build system (Astro) reads PUBLIC_* values into client code at
# build time. Anything WITHOUT the PUBLIC_ prefix is server-only — keep
# secrets there.
#
# Variables here are read in:
#   • src/components/forms/ContactForm.astro
#   • src/components/forms/Captcha.astro

# ---------------------------------------------------------------------------
# Contact form vendor
# ---------------------------------------------------------------------------
# Pick ONE vendor. We use Web3Forms by default because the free tier handles
# 250 submissions/month with no client account, ideal until Cloudflare lands.
# When Cloudflare onboarding completes, swap this to a Cloudflare Worker
# endpoint (PUBLIC_CONTACT_FORM_ENDPOINT changes; everything else stays).
#
# Web3Forms: https://web3forms.com/
PUBLIC_CONTACT_FORM_ENDPOINT="https://api.web3forms.com/submit"
PUBLIC_CONTACT_FORM_ACCESS_KEY=""    # required by Web3Forms; set after sign-up

# Alternative: Formspree
# PUBLIC_CONTACT_FORM_ENDPOINT="https://formspree.io/f/<formid>"

# ---------------------------------------------------------------------------
# hCaptcha (free tier, GDPR/PDPL friendlier than reCAPTCHA)
# ---------------------------------------------------------------------------
# Site key is public; the secret key (server-side) is held by the form
# vendor's settings page (Web3Forms / Formspree both support hCaptcha).
PUBLIC_HCAPTCHA_SITE_KEY=""

# ---------------------------------------------------------------------------
# Site canonical (rarely overridden)
# ---------------------------------------------------------------------------
# Defaults to https://www.convergent.sa via src/config/site.mjs. Override
# only for staging or preview environments.
# PUBLIC_SITE_URL="https://staging.convergent.sa"
