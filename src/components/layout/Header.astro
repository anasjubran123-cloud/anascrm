---
import Logo from '@components/layout/Logo.astro';
import LanguageSwitcher from '@components/layout/LanguageSwitcher.astro';
import ThemeToggle from '@components/layout/ThemeToggle.astro';
import MobileMenu from '@components/layout/MobileMenu.astro';
import BusinessUnitsDropdown from '@components/layout/BusinessUnitsDropdown.astro';
import { dictFor, localizedPath } from '@lib/i18n';
import type { Locale } from '@config/site';

interface Props {
  locale: Locale;
  pathInLocale: string;
}

const { locale, pathInLocale } = Astro.props;
const dict = dictFor(locale);

// Primary nav (Business Units rendered as a dropdown).
const navItems = [
  { key: 'about', href: localizedPath(locale, 'about'), label: dict.nav.about },
  { key: 'capabilities', href: localizedPath(locale, 'capabilities'), label: dict.nav.capabilities },
  { key: 'sectors', href: localizedPath(locale, 'sectors'), label: dict.nav.sectors },
  { key: 'projects', href: localizedPath(locale, 'projects'), label: dict.nav.projects },
  { key: 'news', href: localizedPath(locale, 'news'), label: dict.nav.news },
  { key: 'careers', href: localizedPath(locale, 'careers'), label: dict.nav.careers },
  { key: 'contact', href: localizedPath(locale, 'contact'), label: dict.nav.contact },
];

// Highlight the current section. Match by the first path segment after the
// locale (e.g. "about", "capabilities").
const currentSegment = (pathInLocale.split('/').filter(Boolean)[0] ?? '');
function isActive(key: string): boolean {
  if (key === 'home' && currentSegment === '') return true;
  return currentSegment === key.toLowerCase() || currentSegment === key;
}
---

<header class="sticky top-0 z-40 border-b border-line bg-surface-0/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-wide items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href={localizedPath(locale, '/')}
      class="block focus-visible:rounded focus-visible:outline-2"
      aria-label={dict.meta.siteName}
    >
      <Logo locale={locale} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.key) ? 'page' : undefined}
          class:list={[
            'rounded px-3 py-2 text-sm font-medium transition-colors',
            isActive(item.key) ? 'text-ink-0' : 'text-ink-1 hover:text-ink-0',
          ]}
        >
          {item.label}
        </a>
      ))}
      <BusinessUnitsDropdown locale={locale} />
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} pathInLocale={pathInLocale} class="hidden sm:inline-flex" />
      <ThemeToggle locale={locale} />
      <MobileMenu locale={locale} pathInLocale={pathInLocale} />
    </div>
  </div>
</header>
