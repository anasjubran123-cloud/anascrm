---
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Heading from '@components/ui/Heading.astro';
import { partners } from '@lib/content';

interface Props {
  eyebrow: string;
  title: string;
  note: string;
}

const { eyebrow, title, note } = Astro.props;
---

<Section tone="subtle">
  <Container>
    <div class="max-w-2xl">
      <Eyebrow>{eyebrow}</Eyebrow>
      <Heading level={2} size="lg" class="mt-3">{title}</Heading>
      <p class="mt-3 text-sm text-ink-2">{note}</p>
    </div>
    <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-6">
      {partners.map((p) => (
        <li class="flex h-16 items-center justify-center rounded border border-line bg-surface-0 px-4 text-sm font-semibold text-ink-1">
          {p.name}
        </li>
      ))}
    </ul>
  </Container>
</Section>
