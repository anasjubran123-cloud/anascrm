---
// Lightweight inline icon set, sized via currentColor.
// Master prompt forbids emoji-as-icon; everything here is bespoke SVG.

interface Props {
  name:
    | 'arrow-right'
    | 'arrow-left'
    | 'menu'
    | 'close'
    | 'sun'
    | 'moon'
    | 'check'
    | 'chevron-down'
    | 'external'
    | 'mail'
    | 'phone'
    | 'whatsapp'
    | 'pin'
    | 'shield'
    | 'server'
    | 'monitor'
    | 'zap';
  size?: number;
  class?: string;
  decorative?: boolean;
  label?: string;
}

const { name, size = 20, class: className = '', decorative = true, label } = Astro.props;

const aria = decorative ? { 'aria-hidden': 'true', focusable: 'false' } : { role: 'img', 'aria-label': label ?? name };
const stroke = 1.75;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...aria}
>
  {name === 'arrow-right' && <>
    <path d="M5 12h14"/>
    <path d="m13 5 7 7-7 7"/>
  </>}
  {name === 'arrow-left' && <>
    <path d="M19 12H5"/>
    <path d="m11 19-7-7 7-7"/>
  </>}
  {name === 'menu' && <>
    <path d="M4 6h16"/>
    <path d="M4 12h16"/>
    <path d="M4 18h16"/>
  </>}
  {name === 'close' && <>
    <path d="M18 6 6 18"/>
    <path d="m6 6 12 12"/>
  </>}
  {name === 'sun' && <>
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </>}
  {name === 'moon' && <>
    <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
  </>}
  {name === 'check' && <>
    <path d="M20 6 9 17l-5-5"/>
  </>}
  {name === 'chevron-down' && <>
    <path d="m6 9 6 6 6-6"/>
  </>}
  {name === 'external' && <>
    <path d="M7 7h10v10"/>
    <path d="M7 17 17 7"/>
  </>}
  {name === 'mail' && <>
    <rect x="3" y="5" width="18" height="14" rx="2"/>
    <path d="m3 7 9 6 9-6"/>
  </>}
  {name === 'phone' && <>
    <path d="M22 16.92V20a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3.09a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.38a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/>
  </>}
  {name === 'whatsapp' && <>
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
  </>}
  {name === 'pin' && <>
    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
    <circle cx="12" cy="10" r="3"/>
  </>}
  {name === 'shield' && <>
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
  </>}
  {name === 'server' && <>
    <rect x="2" y="3" width="20" height="6" rx="1"/>
    <rect x="2" y="15" width="20" height="6" rx="1"/>
    <path d="M6 6h.01M6 18h.01"/>
  </>}
  {name === 'monitor' && <>
    <rect x="2" y="4" width="20" height="14" rx="2"/>
    <path d="M8 22h8M12 18v4"/>
  </>}
  {name === 'zap' && <>
    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
  </>}
</svg>
