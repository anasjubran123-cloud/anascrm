---
interface Props {
  as?: string;
  class?: string;
  href?: string;
  hover?: boolean;
}

const { as = 'div', class: className = '', href, hover = !!href } = Astro.props;
const Tag = href ? 'a' : as;
---

<Tag
  href={href}
  class:list={[
    'block rounded-lg border border-line bg-surface-0 p-6 sm:p-8',
    'shadow-[var(--ct-shadow-1)]',
    hover && 'transition-all duration-[var(--ct-duration-2)] ease-[var(--ct-ease)] hover:border-line-strong hover:shadow-[var(--ct-shadow-2)] hover:-translate-y-0.5',
    className,
  ]}
>
  <slot />
</Tag>
