---
// Renders one or more JSON-LD blobs in <script type="application/ld+json">.
// Slim component so individual pages can compose Organization + LocalBusiness
// + page-specific blocks (Article, BreadcrumbList) in one place.
//
// Output is JSON.stringify with 0 indentation — no human-readable indenting
// because that bloats the HTML.

interface Props {
  data: unknown | unknown[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{items.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}
