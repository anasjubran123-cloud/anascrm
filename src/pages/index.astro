---
// Root path bounces to the default locale. Astro renders this as a static
// HTML redirect; users land on /en or /ar based on their stored choice
// (handled client-side in Phase 3) or on the default.
import { defaultLocale, localizedPath } from '@lib/i18n';

const target = localizedPath(defaultLocale(), '/');

return Astro.redirect(target, 302);
---
