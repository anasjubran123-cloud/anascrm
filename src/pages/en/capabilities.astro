---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Heading from '@components/ui/Heading.astro';
import Card from '@components/ui/Card.astro';
import Icon from '@components/icons/Icon.astro';
import Cta from '@components/sections/Cta.astro';
import { dictFor, localizedPath } from '@lib/i18n';
import { groupCapabilities, pick } from '@lib/content';

const locale = 'en' as const;
const dict = dictFor(locale);
---

<BaseLayout locale={locale} title={dict.capabilities.title} description={dict.capabilities.lead} pathInLocale="/capabilities">
  <Section tone="default">
    <Container>
      <div class="max-w-3xl">
        <Eyebrow>{dict.capabilities.eyebrow}</Eyebrow>
        <Heading level={1} size="display" class="mt-4">{dict.capabilities.title}</Heading>
        <p class="mt-6 max-w-prose text-[length:var(--ct-text-md)] text-ink-1">{dict.capabilities.lead}</p>
      </div>
    </Container>
  </Section>

  <Section tone="subtle" flush>
    <Container>
      <div class="grid gap-4 py-12 sm:grid-cols-2 lg:grid-cols-2">
        {groupCapabilities.map((c) => (
          <Card>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded bg-[rgb(var(--ct-brand-soft))]">
              <Icon name={c.iconName} size={18} class="text-brand" />
            </span>
            <Heading level={2} size="md" class="mt-4">{pick(c.title, locale)}</Heading>
            <p class="mt-3 text-ink-1">{pick(c.summary, locale)}</p>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <Cta
    title={dict.home.ctaTitle}
    lead={dict.home.ctaLead}
    primary={{ label: dict.home.ctaPrimary, href: localizedPath(locale, 'contact') }}
  />
</BaseLayout>
