---
import BaseLayout from '@layouts/BaseLayout.astro';
import { dictFor, localizedPath } from '@lib/i18n';

const locale = 'en' as const;
const dict = dictFor(locale);
---

<BaseLayout locale={locale} pathInLocale="/">
  <section class="mx-auto max-w-wide px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-brand">{dict.home.heroEyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
      {dict.home.heroTitle}
    </h1>
    <p class="mt-6 max-w-prose text-lg text-ink-1">
      {dict.home.heroLead}
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={localizedPath(locale, 'contact')}
        class="inline-flex items-center rounded bg-brand px-5 py-3 text-sm font-semibold text-brand-contrast hover:opacity-90 transition-opacity"
      >
        {dict.home.heroPrimaryCta}
      </a>
      <a
        href={localizedPath(locale, 'business-units')}
        class="inline-flex items-center rounded border border-line-strong px-5 py-3 text-sm font-semibold text-ink-0 hover:bg-surface-1 transition-colors"
      >
        {dict.home.heroSecondaryCta}
      </a>
    </div>
  </section>
</BaseLayout>
