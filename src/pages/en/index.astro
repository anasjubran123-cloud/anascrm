---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import CapabilitiesGrid from '@components/sections/CapabilitiesGrid.astro';
import BusinessUnitsGrid from '@components/sections/BusinessUnitsGrid.astro';
import SectorsStrip from '@components/sections/SectorsStrip.astro';
import PartnersStrip from '@components/sections/PartnersStrip.astro';
import Cta from '@components/sections/Cta.astro';
import { dictFor, localizedPath } from '@lib/i18n';

const locale = 'en' as const;
const dict = dictFor(locale);
---

<BaseLayout locale={locale} pathInLocale="/">
  <Hero
    eyebrow={dict.home.heroEyebrow}
    title={dict.home.heroTitle}
    lead={dict.home.heroLead}
    primary={{ label: dict.home.heroPrimaryCta, href: localizedPath(locale, 'contact') }}
    secondary={{ label: dict.home.heroSecondaryCta, href: localizedPath(locale, 'business-units') }}
  />

  <BusinessUnitsGrid
    locale={locale}
    eyebrow={dict.home.businessUnitsEyebrow}
    title={dict.home.businessUnitsTitle}
    lead={dict.home.businessUnitsLead}
    tone="default"
  />

  <CapabilitiesGrid
    locale={locale}
    eyebrow={dict.home.capabilitiesEyebrow}
    title={dict.home.capabilitiesTitle}
    lead={dict.home.capabilitiesLead}
  />

  <SectorsStrip
    locale={locale}
    eyebrow={dict.home.sectorsEyebrow}
    title={dict.home.sectorsTitle}
    lead={dict.home.sectorsLead}
  />

  <PartnersStrip
    eyebrow={dict.home.partnersEyebrow}
    title={dict.home.partnersTitle}
    note={dict.home.partnersNote}
  />

  <Cta
    title={dict.home.ctaTitle}
    lead={dict.home.ctaLead}
    primary={{ label: dict.home.ctaPrimary, href: localizedPath(locale, 'contact') }}
    secondary={{ label: dict.home.ctaSecondary, href: 'mailto:info@convergent.sa' }}
  />
</BaseLayout>
